class_name CharacterModel
extends Node3D
## A fighter's sculpted, skinned body (generated by tools/assets/sculpt from the fighter's look and
## stored in assets/characters/<id>.wfm). Its skeleton copies the Rig's joints every frame, curls
## the fingers and turns the eyes, so the mesh follows the animation without the Rig knowing.

const DIR := "res://assets/characters/"
const MAGIC := "WFM1"

var skeleton: Skeleton3D
var header: Dictionary = {}
## Mesh instances by name ("body", "eye_l", ...).
var parts: Dictionary = {}
var materials: Dictionary = {}
## One skeleton per cloth sheet in the fighter's look (skirts, long hair), posed by ClothSheet.
var cloth_skeletons: Array[Skeleton3D] = []
var cloth_anchored: Array[bool] = []
var _joint_bones: Array = []
## [bone, rest Transform3D, open Quaternion, fist Quaternion, side]
var _fingers: Array = []
var _eyes: Array = []
var _rig: Rig


static func path_for(id: String) -> String:
	return DIR + id + ".wfm"


## What a fighter's model is generated from; a stored model with a different hash is out of
## date (regenerate with tools/assets/export_rigs.gd and tools/assets/sculpt/build.py).
static func look_hash(def: FighterDef) -> String:
	return JSON.stringify([def.height, def.look]).sha256_text().substr(0, 16)


## Reads a .wfm file; returns {"header": Dictionary, "payload": PackedByteArray} or {} on error.
static func read(path: String) -> Dictionary:
	var f := FileAccess.open(path, FileAccess.READ)
	if f == null:
		return {}
	if f.get_buffer(4).get_string_from_ascii() != MAGIC:
		return {}
	var hl := f.get_32()
	var cl := f.get_32()
	var hdr: Variant = JSON.parse_string(f.get_buffer(hl).get_string_from_utf8())
	if not hdr is Dictionary:
		return {}
	var payload := f.get_buffer(cl).decompress(int(hdr["payload_bytes"]), FileAccess.COMPRESSION_DEFLATE)
	return {"header": hdr, "payload": payload}


func build(rig: Rig, id: String, mats: Dictionary) -> bool:
	_rig = rig
	var data := read(path_for(id))
	if data.is_empty():
		push_error("missing character model for " + id)
		return false
	header = data["header"]
	var payload: PackedByteArray = data["payload"]
	materials = mats
	skeleton = Skeleton3D.new()
	skeleton.name = "Skeleton"
	add_child(skeleton)
	var skin := Skin.new()
	var index := {}
	for b: Dictionary in header["bones"]:
		var i := skeleton.add_bone(str(b["name"]))
		index[b["name"]] = i
		if str(b["parent"]) != "":
			skeleton.set_bone_parent(i, index[b["parent"]])
		var rest := _xf(b["rest"])
		skeleton.set_bone_rest(i, rest)
		skeleton.set_bone_pose(i, rest)
		skin.add_bind(i, _xf(b["bind"]).affine_inverse())
		var nm := str(b["name"])
		if b.has("fist"):
			_fingers.append([i, rest, _q(b["open"]), _q(b["fist"]), 0 if nm.ends_with("_l") else 1])
		elif nm.begins_with("eye_"):
			_eyes.append([i, rest])
	for j: String in Rig.JOINTS:
		_joint_bones.append([index[j], j])
	var cloth_skins: Array[Skin] = []
	for c: Dictionary in header.get("cloth", []):
		var sk := Skeleton3D.new()
		sk.name = "Cloth%d" % cloth_skeletons.size()
		sk.top_level = true
		add_child(sk)
		sk.global_transform = Transform3D.IDENTITY
		var cs := Skin.new()
		if c["head"]:
			cs.add_bind(sk.add_bone("anchor"), Transform3D.IDENTITY)
		for b: Dictionary in c["bones"]:
			var bind := _xf(b["bind"])
			var i := sk.add_bone("p%d" % sk.get_bone_count())
			sk.set_bone_rest(i, bind)
			cs.add_bind(i, bind.affine_inverse())
		cloth_skeletons.append(sk)
		cloth_anchored.append(bool(c["head"]))
		cloth_skins.append(cs)
	for m: Dictionary in header["meshes"]:
		var mi := MeshInstance3D.new()
		mi.name = str(m["name"])
		mi.mesh = _mesh(m, payload)
		var sk_name := str(m["skeleton"])
		var owner_skel := skeleton
		mi.skin = skin
		if sk_name.begins_with("cloth:"):
			var ci := int(sk_name.trim_prefix("cloth:"))
			owner_skel = cloth_skeletons[ci]
			mi.skin = cloth_skins[ci]
		owner_skel.add_child(mi)
		mi.skeleton = mi.get_path_to(owner_skel)
		var key := str(m["surfaces"][0]["material"])
		if mats.has(key):
			mi.material_override = mats[key]
		parts[mi.name] = mi
	return true


static func _mesh(m: Dictionary, payload: PackedByteArray) -> ArrayMesh:
	var a: Dictionary = m["arrays"]
	var arrays := []
	arrays.resize(Mesh.ARRAY_MAX)
	arrays[Mesh.ARRAY_VERTEX] = _slice(payload, a["vertex"]).to_vector3_array()
	arrays[Mesh.ARRAY_NORMAL] = _slice(payload, a["normal"]).to_vector3_array()
	var flags := 0
	if a.has("uv"):
		arrays[Mesh.ARRAY_TEX_UV] = _slice(payload, a["uv"]).to_vector2_array()
	if a.has("uv2"):
		arrays[Mesh.ARRAY_TEX_UV2] = _slice(payload, a["uv2"]).to_vector2_array()
	if a.has("tangent"):
		arrays[Mesh.ARRAY_TANGENT] = _slice(payload, a["tangent"]).to_float32_array()
	# Albedo and occlusion go in the vertex colour and the rest in float custom channels, formats
	# the OpenGL fallback renderer reads the same way as Forward+.
	if a.has("albedo"):
		arrays[Mesh.ARRAY_COLOR] = _slice(payload, a["albedo"]).to_color_array()
	if a.has("params"):
		arrays[Mesh.ARRAY_CUSTOM0] = _slice(payload, a["params"]).to_float32_array()
		flags |= Mesh.ARRAY_CUSTOM_RGBA_FLOAT << Mesh.ARRAY_FORMAT_CUSTOM0_SHIFT
	if a.has("bind"):
		arrays[Mesh.ARRAY_CUSTOM1] = _slice(payload, a["bind"]).to_float32_array()
		flags |= Mesh.ARRAY_CUSTOM_RGBA_FLOAT << Mesh.ARRAY_FORMAT_CUSTOM1_SHIFT
	arrays[Mesh.ARRAY_BONES] = _slice(payload, a["bones"]).to_int32_array()
	arrays[Mesh.ARRAY_WEIGHTS] = _slice(payload, a["weights"]).to_float32_array()
	if int(a["bones"]["width"]) == 8:
		flags |= Mesh.ARRAY_FLAG_USE_8_BONE_WEIGHTS
	arrays[Mesh.ARRAY_INDEX] = _slice(payload, a["index"]).to_int32_array()
	var mesh := ArrayMesh.new()
	mesh.add_surface_from_arrays(Mesh.PRIMITIVE_TRIANGLES, arrays, [], {}, flags)
	return mesh


static func _slice(payload: PackedByteArray, spec: Dictionary) -> PackedByteArray:
	var off := int(spec["offset"])
	return payload.slice(off, off + int(spec["bytes"]))


static func _xf(a: Array) -> Transform3D:
	return Transform3D(Basis(Vector3(a[0], a[1], a[2]), Vector3(a[3], a[4], a[5]), Vector3(a[6], a[7], a[8])), Vector3(a[9], a[10], a[11]))


static func _q(a: Array) -> Quaternion:
	return Quaternion(float(a[0]), float(a[1]), float(a[2]), float(a[3]))


## Copies the rig's pose: joints, finger curl from the rig's fist values, and the eyes turned
## toward `look_at` (world space) when given.
func sync(look_at := Vector3.INF) -> void:
	for jb in _joint_bones:
		skeleton.set_bone_pose(jb[0], (_rig.joints[jb[1]] as Node3D).transform)
	for fb in _fingers:
		var v: float = _rig.fist[fb[4]]
		var rest: Transform3D = fb[1]
		skeleton.set_bone_pose(fb[0], Transform3D(rest.basis * Basis((fb[2] as Quaternion).slerp(fb[3], v)), rest.origin))
	if look_at.is_finite():
		var head: Transform3D = global_transform * (_rig.xf["head"] as Transform3D)
		var local := head.affine_inverse() * look_at
		var dir := local.normalized()
		# The eyes turn at most 25 degrees from straight ahead.
		var ahead := Vector3(0, 0, -1)
		var ang := ahead.angle_to(dir)
		if ang > deg_to_rad(25.0):
			dir = ahead.slerp(dir, deg_to_rad(25.0) / ang).normalized()
		var q := Quaternion(ahead, dir) if ang > 1e-4 else Quaternion.IDENTITY
		for e in _eyes:
			var rest: Transform3D = e[1]
			skeleton.set_bone_pose(e[0], Transform3D(Basis(q), rest.origin))


## The pose the meshes are sculpted and bound in: arms lowered 45 degrees to the sides and the
## feet apart, so no limb touches the body. Returns [pose, rig-space ankle targets].
static func bind_pose(rig: Rig) -> Array:
	var p := Pose.new()
	var chest: Vector3 = rig.rest["hips"] + rig.rest["spine"] + rig.rest["chest"]
	var reach := (rig.upper_len + rig.fore_len) * 0.999
	for s in ["l", "r"]:
		var side := -1.0 if s == "l" else 1.0
		var shoulder: Vector3 = chest + rig.rest["clav_" + s] + rig.rest["upperarm_" + s]
		var dir := Vector3(side * sin(PI * 0.25), -cos(PI * 0.25), 0.0)
		p.pos["hand_" + s] = shoulder + dir * reach
		p.pos["elbow_" + s] = shoulder + dir * rig.upper_len + Vector3(0, 0, 0.5)
		p.pos["knee_" + s] = Vector3(side * 0.09 * rig.h, 0.27 * rig.h, -0.5)
		p.val["fist_" + s] = 0.0
	var feet := [Vector3(-0.12 * rig.h, rig.ankle_h, 0.0), Vector3(0.12 * rig.h, rig.ankle_h, 0.0)]
	return [p, feet]


## Applies the bind pose to `rig` and returns each joint's rig-space transform in it.
static func bind_transforms(rig: Rig) -> Dictionary:
	var bp := bind_pose(rig)
	rig.apply(bp[0], bp[1], [0.0, 0.0], {})
	return rig.xf.duplicate()
