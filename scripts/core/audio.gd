extends Node
## Music and sound effects. Effects play from a small pool so overlapping hits never cut
## each other off. Sounds are generated by tools/assets/gen_audio.py into assets/audio/.

const SFX_DIR := "res://assets/audio/"
const POOL := 16

var _players: Array[AudioStreamPlayer] = []
var _next := 0
var _cache: Dictionary = {}
var _music: AudioStreamPlayer
var _music_name := ""
var _closed := false


func _ready() -> void:
	process_mode = Node.PROCESS_MODE_ALWAYS
	for bus in ["Music", "SFX"]:
		if AudioServer.get_bus_index(bus) < 0:
			AudioServer.add_bus()
			var i := AudioServer.bus_count - 1
			AudioServer.set_bus_name(i, bus)
			AudioServer.set_bus_send(i, "Master")
	for i in POOL:
		var p := AudioStreamPlayer.new()
		p.bus = "SFX"
		add_child(p)
		_players.append(p)
	_music = AudioStreamPlayer.new()
	_music.bus = "Music"
	add_child(_music)
	apply_volumes()


## Stops every sound for good; called on quit.
func close() -> void:
	_closed = true
	_music.stop()
	_music_name = ""
	for p in _players:
		p.stop()


func apply_volumes() -> void:
	var s: Node = get_node_or_null("/root/Settings")
	if s == null:
		return
	_set_bus("Master", s.get_value("master_volume"))
	_set_bus("Music", s.get_value("music_volume"))
	_set_bus("SFX", s.get_value("sfx_volume"))


func _set_bus(bus: String, v: float) -> void:
	var i := AudioServer.get_bus_index(bus)
	if i >= 0:
		AudioServer.set_bus_volume_db(i, linear_to_db(maxf(v, 0.0001)))
		AudioServer.set_bus_mute(i, v <= 0.001)


func stream(sound: String) -> AudioStream:
	if not _cache.has(sound):
		var path := SFX_DIR + sound + ".wav"
		_cache[sound] = load(path) if ResourceLoader.exists(path) else null
	return _cache[sound]


func play(sound: String, volume_db := 0.0, pitch := 1.0) -> void:
	var s := stream(sound)
	if s == null or _closed:
		return
	var p := _players[_next]
	_next = (_next + 1) % POOL
	p.stream = s
	p.volume_db = volume_db
	p.pitch_scale = pitch
	p.play()


func play_music(track: String) -> void:
	if _closed or (track == _music_name and _music.playing):
		return
	_music_name = track
	var s := stream(track)
	if s is AudioStreamWAV:
		(s as AudioStreamWAV).loop_mode = AudioStreamWAV.LOOP_FORWARD
		(s as AudioStreamWAV).loop_end = (s as AudioStreamWAV).data.size() / 2
	_music.stream = s
	if s:
		_music.play()



func pause_music(on: bool) -> void:
	_music.stream_paused = on


func stop_music() -> void:
	_music.stop()
	_music_name = ""


func current_music() -> String:
	return _music_name
