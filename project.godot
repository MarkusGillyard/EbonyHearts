; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Mortal Slopbat"
config/description="A 3D arcade fighting game on a classic side-on plane."
config/version="1.1.0"
run/main_scene="res://scenes/main.tscn"
config/use_custom_user_dir=true
config/custom_user_dir_name="MortalSlopbat"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/bg_color=Color(0.02, 0.03, 0.03, 1)
boot_splash/show_image=false
config/icon="res://assets/icon.png"

[autoload]

Content="*res://scripts/core/content.gd"
Settings="*res://scripts/core/settings.gd"
Progress="*res://scripts/core/progress.gd"
Audio="*res://scripts/core/audio.gd"
Game="*res://scripts/core/game.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1600
window/size/window_height_override=900
window/stretch/mode="canvas_items"

[input_devices]

buffering/agile_event_flushing=true

[physics]

common/max_physics_steps_per_frame=4
common/physics_jitter_fix=0.0

[rendering]

lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
anti_aliasing/quality/msaa_3d=2
environment/defaults/default_clear_color=Color(0.02, 0.03, 0.03, 1)
