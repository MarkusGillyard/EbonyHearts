# Regenerated by the engine or UnrealBuildTool
Binaries/
DerivedDataCache/
Intermediate/
Saved/
Plugins/*/Binaries/
Plugins/*/Intermediate/
Build/*/FileOpenOrder/

# Generated by GenerateProjectFiles.sh, or machine-specific (.vscode/launch.json)
.vscode/
.ignore
*.code-workspace
Makefile

# Local tool output
Tools/__pycache__/
SourceArt/**/__pycache__/
/Evidence/scratch/

# Blender user configs isolated for the art tools (add-ons are fetched, not versioned)
Tools/blender/**/.blender_user/
Tools/**/__pycache__/
# Raw third-party downloads: provenance and hashes live in SourceArt/ThirdParty/ledger.json;
# what the game uses is imported under Content/ and licensed in Docs/ThirdParty.
SourceArt/ThirdParty/*/*
!SourceArt/ThirdParty/*/_license/
!SourceArt/ThirdParty/MakeHuman/PROVENANCE.json
!SourceArt/ThirdParty/MakeHuman/downloads/
SourceArt/ThirdParty/MakeHuman/downloads/*
!SourceArt/ThirdParty/MakeHuman/downloads/*license_files*/

# Derived art that the scripts rebuild (Tools/prep_surfaces.py, Tools/blender/*): the game's
# imported copies live under Content/, the inputs are the scripts and the ledger.
SourceArt/Surfaces/
SourceArt/Fighters/*/*.png
SourceArt/Fighters/*/*.blend
SourceArt/Fighters/*/*.blend1
SourceArt/Fighters/*/*.fbx
SourceArt/Fighters/*/*.log
SourceArt/Fighters/*/renders/
SourceArt/Stages/*/review/*
!SourceArt/Stages/*/review/*_sheet.png
